{
  "name": "craft-skills",
  "version": "0.1.0",
  "description": "Install AI agent skills from GitHub into your project",
  "keywords": [
    "ai",
    "agent",
    "skills",
    "claude",
    "cursor",
    "codex",
    "windsurf",
    "cli"
  ],
  "license": "MIT",
  "author": "Karim Mohamed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komtcho/craft-skills.git"
  },
  "homepage": "https://github.com/komtcho/craft-skills#readme",
  "bugs": {
    "url": "https://github.com/komtcho/craft-skills/issues"
  },
  "type": "module",
  "bin": {
    "craft-skills": "./dist/index.js",
    "craft": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.build-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && cd .build-test && node --test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
